#!/bin/sh
set -eu
appdir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# Use the bundled ELF loader together with its matching glibc and Qt libraries.
export QT_PLUGIN_PATH="$appdir/usr/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$appdir/usr/plugins/platforms"
export QT_QPA_FONTDIR="$appdir/usr/share/yggguard"
export LD_LIBRARY_PATH="$appdir/usr/lib"
exec "$appdir/usr/lib/ld-linux-x86-64.so.2" --library-path "$appdir/usr/lib" "$appdir/usr/bin/yggguard" "$@"
